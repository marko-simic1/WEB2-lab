{
  "name": "web2-lab",
  "version": "1.0.0",
  "scripts": {
    "clean": "shx rm -rf dist",
    "copy-files": "shx cp -r src/views dist && shx cp -r src/public dist",
    "build": "npm run clean && tsc && npm run copy-files",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.7.1",
    "express-openid-connect": "^2.19.2",
    "pg": "^8.16.3",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/pug": "^2.0.10",
    "@types/qrcode": "^1.5.6",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  }
}
